@page "{id:int}"
@model Quotebook.Web.Pages.Invoices.DetailsModel
@using Quotebook.Core
@using Quotebook.Core.Entities
@using Quotebook.Web.Infrastructure
@{
    var inv = Model.Invoice;
    ViewData["Title"] = inv.Number;
    var percentPaid = inv.Total > 0 ? (int)Math.Round(inv.Paid / inv.Total * 100) : 0;
}

<div class="crumbs"><a asp-page="Index">Invoices</a> <span aria-hidden="true">/</span> @inv.Number</div>

<div class="page-head">
    <div>
        <h1 class="money" style="font-weight: 500; letter-spacing: -0.03em;">@inv.Number</h1>
        <p class="sub"><span class="status @Model.Status.Css()">@Model.Status.Label()</span> &nbsp; @inv.Customer?.Name</p>
    </div>
    <div class="actions">
        <button type="button" class="btn secondary" onclick="window.print()">Print</button>
        @if (inv.Balance > 0)
        {
            <a href="#record" class="btn">Record a payment</a>
        }
    </div>
</div>

@if (Model.Message is not null) { <div class="alert success">@Model.Message</div> }
@if (Model.Error is not null) { <div class="alert danger">@Model.Error</div> }

<div class="columns">

    <section class="main panel doc" aria-label="Invoice">
        <dl class="facts" style="margin: 0;">
            <div><dt>Billed to</dt><dd>@inv.Customer?.Name</dd></div>
            <div><dt>Issued</dt><dd>@inv.IssuedOn.ToString("d MMM yyyy")</dd></div>
            <div><dt>Payment due</dt><dd>@inv.DueOn.ToString("d MMM yyyy")</dd></div>
            @if (inv.Quote is not null)
            {
                <div><dt>From quotation</dt><dd><a asp-page="/Quotes/Details" asp-route-id="@inv.Quote.Id" class="ref">@inv.Quote.Number</a></dd></div>
            }
        </dl>

        <div class="table-wrap">
            <table class="lines">
                <thead><tr><th>Description</th><th class="right">Qty</th><th class="right u">Unit price</th><th class="right">Amount</th></tr></thead>
                <tbody>
                @foreach (var line in inv.Lines)
                {
                    <tr>
                        <td>@line.Description</td>
                        <td class="num">@line.Quantity.ToString("0.###")</td>
                        <td class="num u">@line.UnitPrice.Rm()</td>
                        <td class="num">@line.Total.Rm()</td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="totals">
                <div><span class="muted">Total (RM)</span><span class="money">@inv.Total.Rm()</span></div>
                <div><span class="muted">Paid</span><span class="money">@inv.Paid.Rm()</span></div>
                <div class="due"><span>Balance (RM)</span><span class="money">@inv.Balance.Rm()</span></div>
            </div>
        </div>
    </section>

    <aside class="side">

        <section class="panel pad" aria-label="Payments">
            <div class="section-head" style="margin-bottom: 0;">
                <h2>Payments</h2>
                <span class="muted small">@percentPaid% paid</span>
            </div>
            <div class="progress" role="img" aria-label="@percentPaid percent paid"><span style="width: @(percentPaid)%;"></span></div>

            @if (inv.Payments.Count == 0)
            {
                <p class="muted">No payments yet.</p>
            }
            else
            {
                @foreach (var p in inv.Payments.OrderBy(p => p.PaidOn).ThenBy(p => p.Id))
                {
                    <div class="payment">
                        <div>
                            <div style="font-weight: 500;">@(string.IsNullOrWhiteSpace(p.Note) ? "Payment" : p.Note)</div>
                            <div class="muted small">@p.PaidOn.ToString("d MMM yyyy")</div>
                        </div>
                        <div class="right">
                            <div class="money">@p.Amount.Rm()</div>
                            @if (User.IsInRole(Roles.Owner))
                            {
                                <form method="post" asp-page-handler="DeletePayment" asp-route-id="@inv.Id" asp-route-paymentId="@p.Id" class="inline"
                                      onsubmit="return confirm('Remove this payment?');">
                                    <button type="submit" class="link-button danger small" style="min-height: 0;">Remove</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
        </section>

        @if (inv.Balance > 0)
        {
            <section id="record" class="panel pad" aria-label="Record a payment">
                <h2 style="margin-bottom: 14px;">Record a payment</h2>
                <form method="post" asp-page-handler="Payment" asp-route-id="@inv.Id" class="form" novalidate>
                    <div asp-validation-summary="ModelOnly" class="field-error"></div>
                    <div class="field">
                        <label asp-for="Payment.Amount">Amount (RM)</label>
                        <input asp-for="Payment.Amount" class="money" inputmode="decimal" />
                        <span asp-validation-for="Payment.Amount" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Payment.PaidOn">Paid on</label>
                        <input asp-for="Payment.PaidOn" />
                    </div>
                    <div class="field">
                        <label asp-for="Payment.Note">Note <span class="opt">(optional)</span></label>
                        <input asp-for="Payment.Note" />
                    </div>
                    <button type="submit" class="btn block">Record payment</button>
                </form>
            </section>
        }
        else
        {
            <p class="status paid" style="font-weight: 500;">Fully paid. Thank you.</p>
        }
    </aside>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
