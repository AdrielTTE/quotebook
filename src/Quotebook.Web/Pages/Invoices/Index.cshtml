@page
@model Quotebook.Web.Pages.Invoices.IndexModel
@using Quotebook.Core.Entities
@using Quotebook.Web.Infrastructure
@{ ViewData["Title"] = "Invoices"; }

<div class="page-head">
    <div>
        <h1>Invoices</h1>
        <p class="sub">Create an invoice from an accepted quotation.</p>
    </div>
</div>

<form method="get" class="search">
    <input type="search" name="q" value="@Model.Q" placeholder="Search number or customer" aria-label="Search invoices" />
    @if (Model.Status is not null) { <input type="hidden" name="status" value="@Model.Status" /> }
    <button class="btn secondary" type="submit">Search</button>
</form>

<ul class="chips" aria-label="Filter by status">
    <li><a asp-page="Index" asp-route-q="@Model.Q" aria-current="@(Model.Status is null ? "page" : null)">All</a></li>
    @foreach (var s in Enum.GetValues<InvoiceStatus>())
    {
        <li><a asp-page="Index" asp-route-q="@Model.Q" asp-route-status="@s" aria-current="@(Model.Status == s ? "page" : null)">@s.Label()</a></li>
    }
</ul>

@if (Model.Rows.Count == 0)
{
    <div class="panel"><p class="empty">@(string.IsNullOrWhiteSpace(Model.Q) ? "No invoices here yet." : "No invoices match that search.")</p></div>
}
else
{
    <div class="panel table-wrap">
        <table class="ledger cards">
            <thead>
                <tr><th>Number</th><th>Customer</th><th>Status</th><th>Due</th><th class="right">Total (RM)</th><th class="right">Balance (RM)</th></tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr class="@(r.Status == InvoiceStatus.Overdue ? "flag" : "")">
                    <td class="c-ref"><a asp-page="Details" asp-route-id="@r.Invoice.Id" class="ref">@r.Invoice.Number</a></td>
                    <td class="c-title">@r.Invoice.Customer?.Name</td>
                    <td class="c-status"><span class="status @r.Status.Css()">@r.Status.Label()</span></td>
                    <td class="muted c-meta">due @r.Invoice.DueOn.ToString("d MMM yyyy")</td>
                    <td class="right money c-hide">@r.Invoice.Total.Rm()</td>
                    <td class="right money c-amount" style="font-weight: 600;">@r.Invoice.Balance.Rm()</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
