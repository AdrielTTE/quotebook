@page
@model IndexModel
@inject Quotebook.Web.Infrastructure.AppFeatures Features
@{
    ViewData["Title"] = "Quotations and invoices for small businesses";
    ViewData["Description"] = "Write a quotation, get it accepted, turn it into an invoice and track who has paid. A live demo of an ASP.NET Core app for small service businesses. No sign-up needed.";
}

<section class="hero stack" style="gap: 20px;">
    <div>
        <h1>Quotebook</h1>
        <p class="lead">
            Write a quotation, get it accepted, turn it into an invoice, and track who has paid.
            Built for small service businesses like aircon servicers, renovators and photographers.
        </p>
    </div>

    <div class="actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Dashboard" class="btn large">Open your dashboard</a>
        }
        else
        {
            @if (Features.DemoEnabled)
            {
                <form method="post" asp-page="/Account/Demo" class="inline"><button type="submit" class="btn large">Try the demo</button></form>
            }
            <a asp-page="/Account/Login" class="btn secondary large">Sign in</a>
            @if (Features.RegistrationOpen)
            {
                <a asp-page="/Account/Register" class="btn secondary large">Create account</a>
            }
        }
    </div>

    @if (Features.DemoEnabled && User.Identity?.IsAuthenticated != true)
    {
        <p class="muted small" style="max-width: 44em;">
            One click, no sign-up. The demo business is full of sample data and resets itself every 6 hours.
            It runs on free hosting, so the first load after a quiet spell can take up to a minute while the server wakes up.
        </p>
    }
</section>

<section class="features">
    <div>
        <h2>Quote to cash</h2>
        <p class="muted">Draft, send, accept or reject. An accepted quotation becomes an invoice with one click, with its lines copied across.</p>
    </div>
    <div>
        <h2>Payments that add up</h2>
        <p class="muted">Record deposits and instalments. Each invoice shows Unpaid, Partly paid, Paid or Overdue, and the dashboard shows what is owed and what is late.</p>
    </div>
    <div>
        <h2>Your data stays yours</h2>
        <p class="muted">Every business sees only its own customers, quotes and invoices. Owners manage everything; staff can record payments but not remove them.</p>
    </div>
</section>

<p class="muted">
    A portfolio project by <a href="https://appliedtheory.asia">Adriel Tang</a>, built with ASP.NET Core 10, EF Core and PostgreSQL.
    <a href="https://github.com/AdrielTTE/quotebook">Read the code on GitHub</a>.
</p>
