@page
@model Quotebook.Web.Pages.Quotes.IndexModel
@using Quotebook.Web.Infrastructure
@{ ViewData["Title"] = "Quotations"; }

<div class="page-head">
    <h1>Quotations</h1>
    <div class="actions"><a asp-page="Edit" class="btn">New quotation</a></div>
</div>

@if (Model.Message is not null) { <div class="alert success">@Model.Message</div> }

<form method="get" class="search">
    <input type="search" name="q" value="@Model.Q" placeholder="Search number or customer" aria-label="Search quotations" />
    <button class="btn secondary" type="submit">Search</button>
</form>

@if (Model.Quotes.Count == 0)
{
    <div class="panel"><p class="empty">@(string.IsNullOrWhiteSpace(Model.Q) ? "No quotations yet. Create your first one." : "No quotations match that search.")</p></div>
}
else
{
    <div class="panel table-wrap">
        <table class="ledger cards">
            <thead><tr><th>Number</th><th>Customer</th><th>Status</th><th>Valid until</th><th class="right">Total (RM)</th></tr></thead>
            <tbody>
            @foreach (var q in Model.Quotes)
            {
                <tr>
                    <td class="c-ref"><a asp-page="Details" asp-route-id="@q.Id" class="ref">@q.Number</a></td>
                    <td class="c-title">@q.Customer?.Name</td>
                    <td class="c-status"><span class="status @q.Status.Css()">@q.Status.Label()</span></td>
                    <td class="muted c-meta">valid until @q.ValidUntil.ToString("d MMM yyyy")</td>
                    <td class="right money c-amount">@q.Total.Rm()</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
