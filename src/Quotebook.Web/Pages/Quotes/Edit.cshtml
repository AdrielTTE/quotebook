@page "{id:int?}"
@model Quotebook.Web.Pages.Quotes.EditModel
@{ ViewData["Title"] = Model.Id is null ? "New quotation" : $"Edit {Model.Number}"; }

<div class="page-head"><h1>@ViewData["Title"]</h1></div>

@if (Model.Customers.Count == 0)
{
    <div class="alert info">You need a customer first. <a asp-page="/Customers/Edit">Add one</a>, then come back.</div>
}

<form method="post" class="stack" novalidate>
    <div asp-validation-summary="ModelOnly" class="field-error"></div>
    <input type="hidden" asp-for="Input.Version" />

    <div class="form-grid">
        <div class="field wide">
            <label asp-for="Input.CustomerId">Customer</label>
            <select asp-for="Input.CustomerId" asp-items="Model.Customers">
                <option value="0">Choose a customer</option>
            </select>
            <span asp-validation-for="Input.CustomerId" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.IssuedOn">Issued</label>
            <input asp-for="Input.IssuedOn" />
            <span asp-validation-for="Input.IssuedOn" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ValidUntil">Valid until</label>
            <input asp-for="Input.ValidUntil" />
            <span asp-validation-for="Input.ValidUntil" class="field-error"></span>
        </div>
    </div>

    <div>
        <h2 style="margin-bottom: 12px;">Lines</h2>
        <div id="lines">
            <div class="line-head" aria-hidden="true"><span>Description</span><span>Qty</span><span>Price (RM)</span></div>
            @for (var i = 0; i < Model.Input.Lines.Count; i++)
            {
                <div class="line-row">
                    <input asp-for="Input.Lines[i].Description" placeholder="Description" aria-label="Description" />
                    <input asp-for="Input.Lines[i].Quantity" class="money" inputmode="decimal" aria-label="Quantity" />
                    <input asp-for="Input.Lines[i].UnitPrice" class="money" inputmode="decimal" aria-label="Unit price" />
                </div>
            }
        </div>
        <button type="button" id="add-line" class="btn secondary small" style="margin-top: 4px;">Add another line</button>
    </div>

    <div class="actions">
        <button type="submit" class="btn">Save quotation</button>
        <a asp-page="Index" class="btn secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Clone the last line row and bump its index so the model binder sees one more item.
        document.getElementById('add-line').addEventListener('click', () => {
            const rows = document.querySelectorAll('.line-row');
            const next = rows.length;
            const copy = rows[rows.length - 1].cloneNode(true);
            copy.querySelectorAll('input').forEach(input => {
                input.name = input.name.replace(/Lines\[\d+\]/, 'Lines[' + next + ']');
                input.id = input.id.replace(/Lines_\d+__/, 'Lines_' + next + '__');
                input.value = input.name.endsWith('.Quantity') ? '1' : (input.name.endsWith('.UnitPrice') ? '0' : '');
            });
            rows[rows.length - 1].after(copy);
            copy.querySelector('input').focus();
        });
    </script>
}
