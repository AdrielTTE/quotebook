@page "{id:int}"
@model Quotebook.Web.Pages.Quotes.DetailsModel
@using Quotebook.Core.Entities
@using Quotebook.Web.Infrastructure
@{
    var q = Model.Quote;
    ViewData["Title"] = q.Number;
    var head = LetterheadModel.For(Model.Business, User.FindFirst(TenantClaimsFactory.DisplayNameClaim)?.Value ?? "", "Quotation", q.Number);
}

<div class="crumbs"><a asp-page="Index">Quotations</a> <span aria-hidden="true">/</span> @q.Number</div>

<div class="page-head">
    <div>
        <h1 class="money" style="font-weight: 500; letter-spacing: -0.03em;">@q.Number</h1>
        <p class="sub"><span class="status @q.Status.Css()">@q.Status.Label()</span> &nbsp; @q.Customer?.Name</p>
    </div>
    <div class="actions">
        <button type="button" class="btn secondary" onclick="window.print()">Print</button>
        @if (q.Status == QuoteStatus.Draft)
        {
            <a asp-page="Edit" asp-route-id="@q.Id" class="btn secondary">Edit</a>
            <form method="post" asp-page-handler="Send" asp-route-id="@q.Id" class="inline"><button class="btn" type="submit">Mark as sent</button></form>
            <form method="post" asp-page-handler="Delete" asp-route-id="@q.Id" class="inline" onsubmit="return confirm('Delete this draft?');">
                <button class="btn danger" type="submit">Delete</button>
            </form>
        }
        @if (q.Status == QuoteStatus.Sent)
        {
            <form method="post" asp-page-handler="Accept" asp-route-id="@q.Id" class="inline"><button class="btn" type="submit">Customer accepted</button></form>
            <form method="post" asp-page-handler="Reject" asp-route-id="@q.Id" class="inline"><button class="btn danger" type="submit">Customer rejected</button></form>
        }
    </div>
</div>

@if (Model.Message is not null) { <div class="alert success">@Model.Message</div> }
@if (Model.Error is not null) { <div class="alert danger">@Model.Error</div> }

<section class="panel doc" aria-label="Quotation">
    <partial name="_Letterhead" model="head" />
    <dl class="facts" style="margin: 0;">
        <div><dt>Quoted to</dt><dd>@q.Customer?.Name</dd></div>
        <div><dt>Issued</dt><dd>@q.IssuedOn.ToString("d MMM yyyy")</dd></div>
        <div><dt>Valid until</dt><dd>@q.ValidUntil.ToString("d MMM yyyy")</dd></div>
    </dl>

    <div class="table-wrap">
        <table class="lines">
            <thead><tr><th>Description</th><th class="right">Qty</th><th class="right u">Unit price</th><th class="right">Amount</th></tr></thead>
            <tbody>
            @foreach (var line in q.Lines)
            {
                <tr>
                    <td>@line.Description</td>
                    <td class="num">@line.Quantity.ToString("0.###")</td>
                    <td class="num u">@line.UnitPrice.Rm()</td>
                    <td class="num">@line.Total.Rm()</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="totals">
            <div class="due"><span>Total (RM)</span><span class="money">@q.Total.Rm()</span></div>
        </div>
    </div>
</section>

@if (q.Status == QuoteStatus.Accepted)
{
    <section class="panel pad">
        @if (q.Invoice is not null)
        {
            <p>Invoiced as <a asp-page="/Invoices/Details" asp-route-id="@q.Invoice.Id" class="ref">@q.Invoice.Number</a>.</p>
        }
        else
        {
            <h2 style="margin-bottom: 12px;">Turn this into an invoice</h2>
            <form method="post" asp-page-handler="Invoice" asp-route-id="@q.Id" class="form" style="max-width: 320px;">
                <div class="field">
                    <label for="dueOn">Payment due</label>
                    <input id="dueOn" name="dueOn" type="date" value="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(8)).AddDays(30).ToString("yyyy-MM-dd")" />
                </div>
                <div><button class="btn" type="submit">Create invoice</button></div>
            </form>
        }
    </section>
}
