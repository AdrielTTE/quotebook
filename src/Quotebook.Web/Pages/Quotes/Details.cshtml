@page "{id:int}"
@model Quotebook.Web.Pages.Quotes.DetailsModel
@using Quotebook.Core.Entities
@{
    ViewData["Title"] = Model.Quote.Number;
    var q = Model.Quote;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="mb-1">@q.Number</h1>
        <span class="badge text-bg-@(q.Status switch { QuoteStatus.Draft => "secondary", QuoteStatus.Sent => "primary", QuoteStatus.Accepted => "success", _ => "danger" })">@q.Status</span>
    </div>
    <a asp-page="Index" class="btn btn-link">All quotations</a>
</div>

@if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<dl class="row">
    <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@q.Customer?.Name</dd>
    <dt class="col-sm-3">Issued</dt><dd class="col-sm-9">@q.IssuedOn.ToString("d MMM yyyy")</dd>
    <dt class="col-sm-3">Valid until</dt><dd class="col-sm-9">@q.ValidUntil.ToString("d MMM yyyy")</dd>
</dl>

<div class="table-responsive">
    <table class="table">
        <thead><tr><th>Description</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Amount</th></tr></thead>
        <tbody>
        @foreach (var line in q.Lines)
        {
            <tr>
                <td>@line.Description</td>
                <td class="text-end">@line.Quantity.ToString("0.###")</td>
                <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                <td class="text-end">@line.Total.ToString("N2")</td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3" class="text-end">Total (RM)</th><th class="text-end">@q.Total.ToString("N2")</th></tr></tfoot>
    </table>
</div>

<div class="d-flex flex-wrap gap-2">
    @if (q.Status == QuoteStatus.Draft)
    {
        <a asp-page="Edit" asp-route-id="@q.Id" class="btn btn-outline-secondary">Edit</a>
        <form method="post" asp-page-handler="Send" asp-route-id="@q.Id"><button class="btn btn-primary" type="submit">Mark as sent</button></form>
        <form method="post" asp-page-handler="Delete" asp-route-id="@q.Id" onsubmit="return confirm('Delete this draft?');">
            <button class="btn btn-outline-danger" type="submit">Delete</button>
        </form>
    }
    @if (q.Status == QuoteStatus.Sent)
    {
        <form method="post" asp-page-handler="Accept" asp-route-id="@q.Id"><button class="btn btn-success" type="submit">Customer accepted</button></form>
        <form method="post" asp-page-handler="Reject" asp-route-id="@q.Id"><button class="btn btn-outline-danger" type="submit">Customer rejected</button></form>
    }
</div>
