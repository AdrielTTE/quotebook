@page "{id:int?}"
@model Quotebook.Web.Pages.Customers.EditModel
@{ ViewData["Title"] = Model.Id is null ? "Add customer" : "Edit customer"; }

<div class="page-head"><h1>@ViewData["Title"]</h1></div>

<form method="post" class="form" novalidate>
    <div asp-validation-summary="ModelOnly" class="field-error"></div>
    <div class="field">
        <label asp-for="Input.Name">Name</label>
        <input asp-for="Input.Name" autocomplete="off" />
        <span asp-validation-for="Input.Name" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Email">Email <span class="opt">(optional)</span></label>
        <input asp-for="Input.Email" autocomplete="off" />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Phone">Phone <span class="opt">(optional)</span></label>
        <input asp-for="Input.Phone" autocomplete="off" />
        <span asp-validation-for="Input.Phone" class="field-error"></span>
    </div>
    <div class="actions">
        <button type="submit" class="btn">Save</button>
        <a asp-page="Index" class="btn secondary">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
