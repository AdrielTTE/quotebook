@page "{id:int?}"
@model Quotebook.Web.Pages.Customers.EditModel
@{ ViewData["Title"] = Model.Id is null ? "Add customer" : "Edit customer"; }

<h1>@ViewData["Title"]</h1>

<form method="post" class="col-md-6" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label">Name</label>
        <input asp-for="Input.Name" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Email <span class="text-muted">(optional)</span></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Phone" class="form-label">Phone <span class="text-muted">(optional)</span></label>
        <input asp-for="Input.Phone" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Phone" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
