@page
@model Quotebook.Web.Pages.Customers.IndexModel
@{ ViewData["Title"] = "Customers"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Customers</h1>
    <a asp-page="Edit" class="btn btn-primary">Add customer</a>
</div>

@if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<form method="get" class="mb-3">
    <div class="input-group">
        <input name="q" value="@Model.Q" class="form-control" placeholder="Search by name" aria-label="Search customers" />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

@if (Model.Customers.Count == 0)
{
    <p class="text-muted">@(string.IsNullOrWhiteSpace(Model.Q) ? "No customers yet. Add your first one." : "No customers match that search.")</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var c in Model.Customers)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Email</td>
                    <td>@c.Phone</td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" class="d-inline"
                              onsubmit="return confirm('Delete this customer?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
