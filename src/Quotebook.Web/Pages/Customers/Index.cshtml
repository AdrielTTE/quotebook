@page
@model Quotebook.Web.Pages.Customers.IndexModel
@{ ViewData["Title"] = "Customers"; }

<div class="page-head">
    <h1>Customers</h1>
    <div class="actions"><a asp-page="Edit" class="btn">Add customer</a></div>
</div>

@if (Model.Message is not null) { <div class="alert success">@Model.Message</div> }
@if (Model.Error is not null) { <div class="alert danger">@Model.Error</div> }

<form method="get" class="search">
    <input type="search" name="q" value="@Model.Q" placeholder="Search by name" aria-label="Search customers" />
    <button class="btn secondary" type="submit">Search</button>
</form>

@if (Model.Customers.Count == 0)
{
    <div class="panel"><p class="empty">@(string.IsNullOrWhiteSpace(Model.Q) ? "No customers yet. Add your first one." : "No customers match that search.")</p></div>
}
else
{
    <div class="panel table-wrap">
        <table class="ledger cards">
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th class="right">Actions</th></tr></thead>
            <tbody>
            @foreach (var c in Model.Customers)
            {
                <tr>
                    <td class="c-title c-wide">@c.Name</td>
                    <td class="muted c-ref">@c.Email</td>
                    <td class="muted c-meta">@c.Phone</td>
                    <td class="right c-actions">
                        <a asp-page="Edit" asp-route-id="@c.Id" class="btn secondary small">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" class="inline"
                              onsubmit="return confirm('Delete this customer?');">
                            <button type="submit" class="btn danger small">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
