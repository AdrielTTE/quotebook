@page
@using Microsoft.AspNetCore.Identity
@using Quotebook.Data
@inject UserManager<ApplicationUser> Users
@{
    ViewData["Title"] = "Dashboard";
    var me = await Users.GetUserAsync(User);
}

<h1>Dashboard</h1>
<p>Signed in as <strong>@me?.DisplayName</strong>. Start with your <a asp-page="/Customers/Index">customers</a>, then write a <a asp-page="/Quotes/Index">quotation</a>.</p>
@if (User.IsInRole("Owner"))
{
    <p><a asp-page="/Settings">Business settings</a></p>
}
