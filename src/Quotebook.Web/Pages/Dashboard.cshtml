@page
@model Quotebook.Web.Pages.DashboardModel
@using Quotebook.Web.Infrastructure
@{ ViewData["Title"] = "Dashboard"; }

@section Band {
    <section class="band" aria-label="Totals">
        <div class="wrap">
            <div>
                <span class="eyebrow">Owed to you · @Model.OutstandingCount unpaid @(Model.OutstandingCount == 1 ? "invoice" : "invoices")</span>
                <span class="big"><span class="cur">RM</span> @Model.Outstanding.Rm()</span>
            </div>
            <div class="band-stats">
                <div class="band-stat">
                    <span class="label">Overdue · @Model.OverdueCount</span>
                    <span class="value @(Model.OverdueCount > 0 ? "late" : "")">RM @Model.OverdueAmount.Rm()</span>
                </div>
                <div class="band-stat">
                    <span class="label">Waiting for a reply · @Model.AwaitingReplyCount</span>
                    <span class="value">RM @Model.AwaitingReplyAmount.Rm()</span>
                </div>
                <div class="band-stat">
                    <span class="label">Collected this month</span>
                    <span class="value good">RM @Model.CollectedThisMonth.Rm()</span>
                </div>
            </div>
        </div>
    </section>
}

<div class="page-head">
    <div>
        <h1>Dashboard</h1>
        <p class="sub">@Model.Today.ToString("dddd, d MMMM yyyy")</p>
    </div>
    <div class="actions">
        <a asp-page="/Quotes/Edit" class="btn">New quotation</a>
    </div>
</div>

<section>
    <div class="section-head"><h2>Needs attention</h2></div>
    <div class="panel">
        @if (Model.OverdueInvoices.Count == 0 && Model.ReadyToInvoice.Count == 0)
        {
            <p class="empty">Nothing needs your attention. Start with your <a asp-page="/Customers/Index">customers</a>, then write a <a asp-page="/Quotes/Index">quotation</a>.</p>
        }
        else
        {
            <ul class="attention">
                @foreach (var i in Model.OverdueInvoices)
                {
                    var days = Model.Today.DayNumber - i.DueOn.DayNumber;
                    <li>
                        <span class="dot red" aria-hidden="true"></span>
                        <span class="what"><a asp-page="/Invoices/Details" asp-route-id="@i.Id" class="ref">@i.Number</a> · @i.Customer?.Name is @days @(days == 1 ? "day" : "days") overdue</span>
                        <span class="act"><span class="money">RM @i.Balance.Rm()</span><a asp-page="/Invoices/Details" asp-route-id="@i.Id">Open</a></span>
                    </li>
                }
                @foreach (var q in Model.ReadyToInvoice)
                {
                    <li>
                        <span class="dot green" aria-hidden="true"></span>
                        <span class="what"><a asp-page="/Quotes/Details" asp-route-id="@q.Id" class="ref">@q.Number</a> · @q.Customer?.Name accepted. Ready to invoice</span>
                        <span class="act"><span class="money">RM @q.Total.Rm()</span><a asp-page="/Quotes/Details" asp-route-id="@q.Id">Create invoice</a></span>
                    </li>
                }
            </ul>
        }
    </div>
</section>

<section>
    <div class="section-head">
        <h2>Recent invoices</h2>
        <a asp-page="/Invoices/Index">View all</a>
    </div>
    <div class="panel table-wrap">
        @if (Model.Recent.Count == 0)
        {
            <p class="empty">No invoices yet. Accept a quotation, then create an invoice from it.</p>
        }
        else
        {
            <table class="ledger cards">
                <thead>
                    <tr><th>Invoice</th><th>Customer</th><th>Status</th><th>Due</th><th class="right">Balance (RM)</th></tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Recent)
                {
                    <tr class="@(r.Status == Quotebook.Core.Entities.InvoiceStatus.Overdue ? "flag" : "")">
                        <td class="c-ref"><a asp-page="/Invoices/Details" asp-route-id="@r.Invoice.Id" class="ref">@r.Invoice.Number</a></td>
                        <td class="c-title">@r.Invoice.Customer?.Name</td>
                        <td class="c-status"><span class="status @r.Status.Css()">@r.Status.Label()</span></td>
                        <td class="muted c-meta">due @r.Invoice.DueOn.ToString("d MMM yyyy")</td>
                        <td class="right money c-amount">@r.Invoice.Balance.Rm()</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</section>

@if (User.IsInRole("Owner"))
{
    <p class="small"><a asp-page="/Settings">Business settings</a></p>
}
