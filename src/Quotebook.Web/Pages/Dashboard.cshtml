@page
@model Quotebook.Web.Pages.DashboardModel
@using Quotebook.Web.Infrastructure
@{ ViewData["Title"] = "Dashboard"; }

<h1>Dashboard</h1>
<p class="text-muted">Signed in as <strong>@Model.DisplayName</strong>.</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Owed to you</div>
            <div class="fs-4 fw-semibold">RM @Model.Outstanding.Rm()</div>
            <div class="small text-muted">@Model.OutstandingCount unpaid @(Model.OutstandingCount == 1 ? "invoice" : "invoices")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 @(Model.OverdueCount > 0 ? "border-danger" : "")"><div class="card-body">
            <div class="text-muted small">Overdue</div>
            <div class="fs-4 fw-semibold @(Model.OverdueCount > 0 ? "text-danger" : "")">RM @Model.OverdueAmount.Rm()</div>
            <div class="small text-muted">@Model.OverdueCount overdue</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Waiting for a reply</div>
            <div class="fs-4 fw-semibold">RM @Model.AwaitingReplyAmount.Rm()</div>
            <div class="small text-muted">@Model.AwaitingReplyCount sent @(Model.AwaitingReplyCount == 1 ? "quotation" : "quotations")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Collected this month</div>
            <div class="fs-4 fw-semibold">RM @Model.CollectedThisMonth.Rm()</div>
        </div></div>
    </div>
</div>

@if (Model.OverdueInvoices.Count > 0)
{
    <h2 class="h5">Overdue invoices</h2>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Invoice</th><th>Customer</th><th>Due</th><th class="text-end">Balance (RM)</th></tr></thead>
            <tbody>
            @foreach (var i in Model.OverdueInvoices)
            {
                <tr>
                    <td><a asp-page="/Invoices/Details" asp-route-id="@i.Id">@i.Number</a></td>
                    <td>@i.Customer?.Name</td>
                    <td>@i.DueOn.ToString("d MMM yyyy")</td>
                    <td class="text-end">@i.Balance.Rm()</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted">Nothing overdue. Start with your <a asp-page="/Customers/Index">customers</a>, then write a <a asp-page="/Quotes/Index">quotation</a>.</p>
}

@if (User.IsInRole("Owner"))
{
    <p><a asp-page="/Settings">Business settings</a></p>
}
