@page
@model ErrorModel
@{ ViewData["Title"] = Model.IsNotFound ? "Page not found" : "Something went wrong"; }

<div class="page-head"><h1>@(Model.IsNotFound ? "Page not found." : "Something went wrong.")</h1></div>
<p class="muted" style="max-width: 560px;">
    @(Model.IsNotFound
        ? "That page does not exist, or the link is out of date."
        : "The page could not be shown. Nothing you entered was lost. Try again in a moment.")
</p>
<div class="actions">
    <a asp-page="/Dashboard" class="btn">Go to the dashboard</a>
    <a asp-page="/Index" class="btn secondary">Home</a>
</div>
<p class="muted small" style="margin-top: 24px;">Reference: <code>@Model.RequestId</code></p>
