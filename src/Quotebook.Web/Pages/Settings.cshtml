@page
@model Quotebook.Web.Pages.SettingsModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "OwnerOnly")]
@{ ViewData["Title"] = "Business settings"; }

<div class="page-head"><h1>Business settings</h1></div>
<p class="muted">Only the owner sees this page. Staff accounts are sent to "Access denied". These details are printed at the top of your quotations and invoices.</p>

@if (Model.Message is not null) { <div class="alert success">@Model.Message</div> }

<form method="post" class="form" novalidate>
    <div asp-validation-summary="ModelOnly" class="field-error"></div>
    <div class="field">
        <label asp-for="Input.Name">Business name</label>
        <input asp-for="Input.Name" autocomplete="organization" />
        <span asp-validation-for="Input.Name" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Address">Address <span class="opt">(optional)</span></label>
        <textarea asp-for="Input.Address" rows="3" autocomplete="street-address" style="padding: 10px 12px;"></textarea>
        <span asp-validation-for="Input.Address" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Phone">Phone <span class="opt">(optional)</span></label>
        <input asp-for="Input.Phone" autocomplete="tel" />
        <span asp-validation-for="Input.Phone" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Email">Email <span class="opt">(optional)</span></label>
        <input asp-for="Input.Email" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>
    <div class="actions"><button type="submit" class="btn">Save</button></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
